# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fight_academy?schema=public"
# Database used by `npm test` integration tests (dropped and re-created by the tests).
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fight_academy_test?schema=public"
PORT=3000
# The academy's timezone: "today", training times and check-in dates are computed in it.
APP_TIMEZONE="Europe/Bucharest"
LOG_LEVEL="info"
# Public address of the app: the SMS with a member's PIN links to <PUBLIC_URL>/cont.
PUBLIC_URL="http://localhost:4200"
# SMSLink.ro gateway (SMSLink account > SMS Gateway > Configurare și setări). Used only when
# SMS is switched on in Administrare › Club; until then reception sees the member's PIN.
SMSLINK_CONNECTION_ID=""
SMSLINK_PASSWORD=""
# Optional sender name approved by SMSLink (default: their numeric short number).
SMSLINK_SENDER=""
# "true": SMSLink validates requests but sends nothing.
SMSLINK_TEST=""
# Optional: passwords for the demo accounts `npm run db:seed` creates when missing.
# Leave empty to have random ones generated and printed once. Never commit real values.
SEED_ADMIN_PASSWORD=""
SEED_RECEPTION_PASSWORD=""
SEED_COACH_PASSWORD=""
